# ── Microsoft Azure App Registration ──────────────────────────────────────────
# Seguí SETUP.md para obtener estos valores desde portal.azure.com
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=tu-client-secret-aqui

# Email del buzón a monitorear (debe pertenecer al tenant)
USER_EMAIL=facturacion@tuempresa.com

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Obtené tu clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Comportamiento ─────────────────────────────────────────────────────────────
# Cada cuántos segundos verificar el correo (default: 60)
POLL_INTERVAL_SECONDS=60

# Palabras en el asunto que identifican una OC (separadas por coma)
OC_SUBJECT_KEYWORDS=orden de compra,purchase order,OC ,PO-,P.O.

# Directorio de salida
OUTPUT_DIR=./output
