{
  "name": "contigo-desktop",
  "version": "1.0.0",
  "description": "Contigo - Tu compañero de escritorio",
  "author": "Contigo",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac dmg --mac arm64 --mac x64",
    "build:mac:zip": "electron-builder --mac zip",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.contigo.desktop",
    "productName": "Contigo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-reload": "^1.5.0"
  }
}
